{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unacro",
  "version": "0.1.0",
  "identifier": "dev.unacro.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Unacro",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "View PDFs, images and 3D models; combine, organize and sign",
    "longDescription": "Unacro is a small, fast, open-source viewer for PDFs, screenshots, images and STL models. Combine documents, reorder and rotate pages, add your signature, convert images, and export PDFs to Markdown.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "contentTypes": [
          "com.adobe.pdf"
        ],
        "name": "PDF document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "jpg",
          "jpeg",
          "jpe",
          "jfif"
        ],
        "mimeType": "image/jpeg",
        "contentTypes": [
          "public.jpeg"
        ],
        "name": "JPEG image",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "png"
        ],
        "mimeType": "image/png",
        "contentTypes": [
          "public.png"
        ],
        "name": "PNG image",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "gif"
        ],
        "mimeType": "image/gif",
        "contentTypes": [
          "com.compuserve.gif"
        ],
        "name": "GIF image",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "heic",
          "heif",
          "hif"
        ],
        "mimeType": "image/heic",
        "contentTypes": [
          "public.heic",
          "public.heif"
        ],
        "name": "HEIC image",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "tif",
          "tiff"
        ],
        "mimeType": "image/tiff",
        "contentTypes": [
          "public.tiff"
        ],
        "name": "TIFF image",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "bmp",
          "dib"
        ],
        "mimeType": "image/bmp",
        "contentTypes": [
          "com.microsoft.bmp"
        ],
        "name": "BMP image",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "stl"
        ],
        "mimeType": "model/stl",
        "contentTypes": [
          "public.standard-tesselated-geometry-format"
        ],
        "name": "STL 3D model",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/unacro.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/unacro.desktop"
      }
    }
  }
}

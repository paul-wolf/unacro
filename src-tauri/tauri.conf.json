{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unacro",
  "version": "0.1.0",
  "identifier": "dev.unacro.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Unacro",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "View, combine, organize and sign PDFs",
    "longDescription": "Unacro is a small, fast, open-source PDF tool for everyday work: view PDFs, combine documents, reorder and rotate pages, add your signature, and export to Markdown.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "contentTypes": [
          "com.adobe.pdf"
        ],
        "name": "PDF document",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/unacro.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/unacro.desktop"
      }
    }
  }
}
